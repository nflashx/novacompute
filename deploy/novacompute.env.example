# /etc/novacompute.env — edit domain and save as root (chmod 600)
NOVA_PORT=8080
NOVA_OAUTH_PORT=8600
NOVA_SITE_URL=https://YOUR_DOMAIN
NOVA_OAUTH_BASE=https://YOUR_DOMAIN
# Optional: stricter signup limits
# NOVA_SIGNUP_LIMIT=3
# NOVA_SIGNUP_DAILY=6
# DEV email-code fallback is off by default. Enable only for direct local
# development (never behind nginx / a tunnel).
NOVA_DEV_MAIL=0
# Optional bank webhook override (otherwise payment_config.json webhook_token)
# NOVA_BANK_WEBHOOK_SECRET=change-me
